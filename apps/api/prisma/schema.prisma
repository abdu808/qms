  @@index([trainingId])
  @@index([competenceRequirementId])
}

// =====================================================
// Audit task 8 (architectural) — FollowUpTask
// مهام متابعة تنشأ تلقائياً من قرارات/إجراءات Management Review
// (و قابلة للتوسيع لمصادر أخرى لاحقاً: NCR/CAPA/AUDIT).
// =====================================================
model FollowUpTask {
  id           String   @id @default(cuid())
  code         String   @unique  // FUT-2026-0001
  title        String
  description  String?  @db.Text
  // المالك (إلزامي — قرارات بدون مالك مرفوضة في route)
  ownerId      String
  owner        User     @relation("FollowUpTaskOwner", fields: [ownerId], references: [id])
  dueDate      DateTime
  // المصدر — يربط المهمة بسجلها الأم (للتتبع)
  source       String   // MANAGEMENT_REVIEW | AUDIT | NCR | CAPA | MANUAL
  sourceId     String   // id of the source record
  status       String   @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  priority     String?  // LOW | MEDIUM | HIGH
  notes        String?  @db.Text
  completedAt  DateTime?
  // من أنشأ المهمة (المراجعة الإدارية المعتمِدة → AI_AGENT_USER_ID أو المستخدم)
  createdById  String
  createdBy    User     @relation("FollowUpTaskCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([ownerId, status])
  @@index([source, sourceId])
  @@index([status, dueDate])
  @@index([deletedAt])
}

// =====================================================
// Audit task 9 (architectural) — AuditFinding
// ملاحظة التدقيق: مستوى بين Audit والـ NCR/CAPA
// ISO 9001:2015 §9.2 — Internal Audit output
// يُسجَّل كلُّ نتيجة تدقيق هنا (بدلاً من JSON field).
// يمكن تصعيد MINOR_NC/MAJOR_NC إلى NCR رسمي عبر /escalate.
// =====================================================
model AuditFinding {
  id           String   @id @default(cuid())
  code         String   @unique        // AF-2026-001

  // ── Audit context ────────────────────────────────
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // ── Classification ───────────────────────────────
  // OBSERVATION | MINOR_NC | MAJOR_NC | POSITIVE_FINDING
  type         String   @default("OBSERVATION")
  clauseRef    String?  // بند ISO المرتبط، مثال "8.4.1" أو "9.2.2"

  // ── Scope ────────────────────────────────────────
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  processId    String?
  process      Process?    @relation(fields: [processId], references: [id])

  // ── Content ──────────────────────────────────────
  title        String
  description  String   @db.Text
  evidence     String?  @db.Text    // الدليل الموضوعي

  // ── Ownership & deadline ─────────────────────────
  ownerId      String?
  owner        User?    @relation("FindingOwner", fields: [ownerId], references: [id])
  dueDate      DateTime?

  // ── Status & resolution ──────────────────────────
  // OPEN | IN_REVIEW | RESOLVED | CLOSED | ESCALATED
  status       String   @default("OPEN")
  response     String?  @db.Text    // رد المدقَّق عليه / خطة التصحيح
  closureNote  String?  @db.Text    // ملاحظة الإغلاق (بعد التحقق)
  closedAt     DateTime?

  // ── Escalation to NCR ────────────────────────────
  // يُعبَّأ تلقائياً عند /escalate → ينشئ NCR ويربطه هنا
  ncrId        String?
  ncr          NCR?     @relation(fields: [ncrId], references: [id])

  // ── Audit trail ──────────────────────────────────
  createdById  String
  createdBy    User     @relation("FindingCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([auditId])
  @@index([status])
  @@index([type])
  @@index([ownerId])
  @@index([deletedAt])
}

// =====================================================
// NOTIFICATION TEMPLATES
// قوالب الرسائل المُرسَلة عبر التكاملات الخارجية
// قابلة للتعديل من واجهة المشرف بدون تعديل الكود
// =====================================================
model NotificationTemplate {
  id          String   @id @default(cuid())
  // معرّف منطقي ثابت — يُستخدم في الكود (مثل: KPI_FIRST_NOTICE)
  // لا يُغيَّر بعد الإنشاء (يربط القالب بحدث محدد)
  eventKey    String   @unique
  // اسم القالب بالعربي للعرض
  name        String
  // وصف موجز لمتى يُرسل هذا القالب
  description String?  @db.Text
  // العنوان (يدعم متغيرات {{var}})
  subject     String
  // متن الرسالة (يدعم متغيرات {{var}})
  body        String   @db.Text
  // قنوات الإرسال المسموحة لهذا القالب (CSV: IN_APP,WHATSAPP,SMS,EMAIL)
  channels    String   @default("IN_APP,WHATSAPP")
  // هل القالب مفعّل؟ إن كان معطّلاً، لا تُرسل التنبيهات لهذا الحدث
  enabled     Boolean  @default(true)
  // فئة (KPI | NCR | COMPLAINT | DOC_REVIEW | …) — لتجميع القوالب
  category    String   @default("KPI")
  // قائمة المتغيرات المتاحة كمرجع للمحرّر (CSV)
  variables   String?  @db.Text
  // last edited
  updatedById String?
  updatedBy   User?    @relation("NotificationTemplateEditor", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([enabled])
}
