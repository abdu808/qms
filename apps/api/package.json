{
  "name": "qms-api",
  "version": "1.0.0",
  "description": "QMS API - Bir Sabia Charity",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "node src/seed.js",
    "iso:prepare:dry-run": "node scripts/prepare-iso9001-readiness.mjs",
    "iso:prepare:apply": "node scripts/prepare-iso9001-readiness.mjs --apply",
    "iso:prepare:publish-docs": "node scripts/prepare-iso9001-readiness.mjs --apply --publish-approved-docs",
    "iso:support:dry-run": "node scripts/ensure-iso-support-items.mjs --dry-run",
    "iso:support:apply": "node scripts/ensure-iso-support-items.mjs --apply",
    "studio": "prisma studio",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "plan2030:dry-run": "node scripts/apply-strategic-plan-2030.mjs --dry-run",
    "plan2030:rollback-test": "node scripts/apply-strategic-plan-2030.mjs --rollback-test",
    "plan2030:apply": "node scripts/apply-strategic-plan-2030.mjs --apply",
    "plan2030:apply:archive": "node scripts/apply-strategic-plan-2030.mjs --apply --archive-legacy",
    "plan2025:polish:dry-run": "node scripts/polish-plan-2025-2027.mjs --dry-run",
    "plan2025:polish:apply": "node scripts/polish-plan-2025-2027.mjs --apply",
    "plan2025:govern:dry-run": "node scripts/govern-plan-kpis-2025-2027.mjs --dry-run",
    "plan2025:govern:apply": "node scripts/govern-plan-kpis-2025-2027.mjs --apply",
    "plan2025:link-activities:dry-run": "node scripts/link-activities-to-indicators-2025-2027.mjs --dry-run",
    "plan2025:link-activities:apply": "node scripts/link-activities-to-indicators-2025-2027.mjs --apply",
    "audit:roles": "node scripts/audit-role-navigation.mjs",
    "audit:roles:report": "node scripts/audit-role-navigation.mjs --write-report",
    "audit:persona": "node scripts/audit-persona-experience.mjs",
    "audit:persona:report": "node scripts/audit-persona-experience.mjs --write-report",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "backup": "node src/services/backup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "officeparser": "^5.2.2",
    "openai": "^4.73.0",
    "prisma": "^5.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
