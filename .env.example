# =====================================================
# QMS Environment Variables — Template
# انسخ هذا الملف إلى .env وعدّل القيم
# ملاحظة: لا تُرسل .env إلى Git — فهو مُستثنى عبر .gitignore
# =====================================================

# Application
NODE_ENV=production
APP_NAME="نظام إدارة الجودة"
APP_URL=https://qms.example.org
PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=qms_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=qms_db
DATABASE_URL=postgresql://qms_user:CHANGE_ME_STRONG_PASSWORD@qms-db:5432/qms_db?schema=public&connection_limit=10&pool_timeout=20

# Security — ولِّد قيماً عشوائية قوية (مثال: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_FOR_JWT_SECRET
JWT_EXPIRES_IN=8h
REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_RANDOM_STRING_FOR_REFRESH
REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# AI encryption — يُشفِّر مفاتيح AI وسرّ الـ webhook في DB (AES-256-GCM)
# مطلوب في الإنتاج ويجب أن يكون 32 حرفاً على الأقل
AI_ENCRYPTION_KEY=change-me-32-byte-minimum-ai-key

# CORS — في الإنتاج يجب تحديد origin صراحةً (لا تستخدم *)
CORS_ORIGIN=https://qms.example.org

# Default Admin — يُنشأ أول مرة فقط عبر seed
# ⚠️ غيّر ADMIN_PASSWORD قبل تشغيل الإنتاج — القيمة الافتراضية Admin@2026 مرفوضة
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_NAME=مسؤول النظام

# Quality Manager — اختياري: يُنشأ عند seed أول مرة
QM_EMAIL=quality@example.org
QM_PASSWORD=

# Email (اختياري — للإشعارات)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org

# Backup — النسخ الاحتياطي اليومي عبر scheduler.js (~02:00 محلياً)
QMS_BACKUP=on
BACKUP_RETENTION_DAYS=30
QMS_BACKUP_DIR=/app/uploads/backups

# Webhook SSRF — قائمة بيضاء اختيارية (hosts مفصولة بفواصل)
# إن تُركت فارغة يُسمح بأي host عام؛ يُحظر دائماً loopback/RFC1918/metadata
WEBHOOK_ALLOWED_HOSTS=

# Demo Data — تعبئة بيانات استراتيجية/KPI/ISO جاهزة على أول تشغيل
# اتركها false للحصول على قاعدة بيانات نظيفة (الافتراضي للنشر الجديد)
SEED_DEMO_DATA=false

# ── seed-data.json (مُولَّد من ملفات Excel، موجود في prisma/seed-data.json) ──
# on  = شغّل seed-from-json.mjs على الإقلاع (أول deploy فقط)
# off = تخطّى (الافتراضي — بعد أول تعبئة ناجحة)
SEED_FROM_JSON=off

# تنبيه أمان: config.js يرفض تشغيل الإنتاج إذا:
#   - JWT_SECRET / REFRESH_SECRET / ADMIN_PASSWORD بقيمتها الافتراضية
#   - CORS_ORIGIN مفقود أو = '*'
